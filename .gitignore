# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
__pycache__/
*.py[cod]

# atomic Feishu sync working sets and local recovery snapshot
/src/data/.feishu-candidate.*/
/src/data/.feishu-restore-candidate.*/
/src/data/.feishu-snapshot-candidate.*/
/src/data/.feishu-last-good/
/src/data/.feishu-pre-restore/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local bot state
/var/

# vercel
.vercel

# local reports and covers source
/daily-reports/
/covers/*.html
/covers/card-*.html
/covers/share-*.html
/covers/export*.py
/covers/export*.sh

# typescript
*.tsbuildinfo
next-env.d.ts
