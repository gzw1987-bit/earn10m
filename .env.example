# Copy to .env, fill locally, and keep the real file mode at 0600.
TELEGRAM_LOG_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Publishing is disabled by default. When true, the bot may commit and push
# only src/data/feishu after the repository passes the clean-worktree guard.
AUTO_PUBLISH_ENABLED=false

# CLI paths (default: executable names on PATH).
CLAUDE_CLI_BIN=claude
LARK_CLI_BIN=lark-cli

# Optional daily-report delivery configuration.
TELEGRAM_DAILY_BOT_TOKEN=
TELEGRAM_DAILY_CHAT_ID=
FEISHU_DAILY_CHAT_ID=
# DAILY_REPORT_DIR defaults to this project's daily-reports directory.
# DAILY_DESKTOP_DIR enables an optional copy of the share image.
